{
  "manifest_version": 3,
  "name": "Snipr Download Manager (SDM)",
  "version": "1.0.0",
  "key": "",
  "description": "IDM-style browser companion for Snipr Download Manager (SDM). Shows 'Download by Snipr' on videos and captures media streams.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "http://127.0.0.1:48921/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Snipr Download Manager (SDM)",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
